# Copy this file to .env.local (and add the same vars in Vercel's project
# settings for production) — .env.local is gitignored, never commit real keys.

# Required: get one at https://resend.com after creating an account.
RESEND_API_KEY=

# Optional: where contact-form submissions are sent. Defaults to
# anthonytij3@gmail.com if unset.
CONTACT_TO_EMAIL=

# Optional: the "from" address on outgoing emails. Defaults to Resend's
# shared onboarding@resend.dev sender, which works immediately but can only
# deliver to the email address on your Resend account. To send to arbitrary
# client inboxes (and to have emails come from your own domain), verify
# capitolcity.tech in the Resend dashboard, then set this to something like
# "Capitol City Tech <hello@capitolcity.tech>".
CONTACT_FROM_EMAIL=
